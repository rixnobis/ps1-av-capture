(version 1)

# The FX3 escape box (rule area BGA_ESC, placed by tools/bga_route.py): 0.1 mm neckdown at
# 0.1 mm clearance, so one track passes between two dogbone vias 0.8 mm apart.
(rule "FX3 escape neckdown"
  (condition "A.intersectsArea('BGA_ESC') && B.intersectsArea('BGA_ESC')")
  (constraint clearance (min 0.1)))

# Everywhere else: the 0.127 mm track/space floor the board was designed to.
(rule "track floor outside the escape box"
  (condition "A.Type == 'track' && !A.intersectsArea('BGA_ESC')")
  (constraint track_width (min 0.127)))
(rule "clearance floor outside the escape box"
  (condition "!A.intersectsArea('BGA_ESC') || !B.intersectsArea('BGA_ESC')")
  (constraint clearance (min 0.127)))
