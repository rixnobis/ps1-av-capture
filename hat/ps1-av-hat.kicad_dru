(version 1)

# Track floor 0.1 mm (JLC 4-layer minimum; Freerouting necks a track to 75 % at a pin exit, 0.1124 mm for the
# 0.15 mm Bus class). The netclass clearance is 0.15 mm.
# Every value carries its unit: kicad-cli 10.0.7 drops a rules file that fails to parse without a word.
(rule "track floor"
  (condition "A.Type == 'track'")
  (constraint track_width (min 0.1mm)))
